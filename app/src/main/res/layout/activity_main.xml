<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Nature Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/natura_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99031913" />

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <!-- Leaf Logo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="🌿"
                android:textSize="48sp" />

            <!-- App Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="NATURA"
                android:textColor="#F1F8F3"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="A BETTER TOMORROW STARTS HERE"
                android:textColor="#B8D9C2"
                android:textSize="11sp"
                android:letterSpacing="0.18" />

            <!-- Glass Login Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:padding="24dp"
                android:orientation="vertical"
                android:background="@drawable/glass_card">

                <!-- Welcome -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Sign in to continue your journey"
                    android:textColor="#C2D4CA"
                    android:textSize="14sp" />

                <!-- Username Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Username"
                    android:textColor="#C8E6C9"
                    android:textSize="14sp" />

                <!-- Username -->
                <EditText
                    android:id="@+id/usernameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_background"
                    android:hint="Enter your username"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9EB3A8"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true" />

                <!-- Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Password"
                    android:textColor="#C8E6C9"
                    android:textSize="14sp" />

                <!-- Password -->
                <EditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_background"
                    android:hint="Enter your password"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9EB3A8"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true" />

                <!-- Forgot Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="11dp"
                    android:text="Forgot Password?"
                    android:textColor="#A5D6A7"
                    android:textSize="13sp" />

                <!-- Login Button -->
                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#4F9B6D"
                    android:text="LOGIN  →"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="──────  or continue with  ──────"
                    android:textColor="#86A495"
                    android:textSize="12sp" />

                <!-- Sign Up -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="Don't have an account?  Sign Up"
                    android:textColor="#E0ECE4"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="18dp"
                android:text="NATURE  •  BALANCE  •  A BRIGHTER YOU"
                android:textColor="#9FBEAA"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>